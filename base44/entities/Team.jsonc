{
  "name": "Team",
  "type": "object",
  "properties": {
    "room_id": {
      "type": "string",
      "title": "Room ID"
    },
    "team_name": {
      "type": "string",
      "title": "Team Name"
    },
    "score": {
      "type": "number",
      "default": 0,
      "title": "Score"
    },
    "answers": {
      "type": "string",
      "title": "Answers (JSON)"
    },
    "kiosk_id": {
      "type": "string",
      "title": "Kiosk ID"
    },
    "finished": {
      "type": "boolean",
      "default": false,
      "title": "Finished"
    }
  },
  "required": [
    "room_id",
    "team_name",
    "kiosk_id"
  ]
}